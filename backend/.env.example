# Application
APP_NAME=CloudMigrate
DEBUG=false
SECRET_KEY=change-me-in-production-use-32-char-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql://cloudmigrate:password@localhost:5432/cloudmigrate

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=cloudmigrate-data
AWS_ENDPOINT_URL=  # Leave empty for real AWS; set to http://localhost:4566 for LocalStack

# SFTP (legacy source)
SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_USER=sftp_user
SFTP_PASSWORD=sftp_password
SFTP_PRIVATE_KEY_PATH=  # Optional: path to private key file

# Webhook
WEBHOOK_SECRET=webhook-signing-secret
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=3

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
